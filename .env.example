# Orixo Digital Agency Platform - Environment Configuration
APP_NAME="Orixo"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

# Database (MySQL 8.0+ / 9.x)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=orixo_db
DB_USERNAME=root
DB_PASSWORD=

# Session & Security
SESSION_NAME=ORIXO_SESSID
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_LIFETIME=28800
SESSION_COOKIE_SECURE=false

# Email Transport ('apps_script' or 'smtp')
MAIL_DRIVER=apps_script
APPS_SCRIPT_WEBHOOK_URL=
APPS_SCRIPT_SECRET=

# Authenticated SMTP (PHPMailer fallback when MAIL_DRIVER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=noreply@orixo.studio
MAIL_FROM_NAME="Orixo Studio"
ADMIN_ALERT_EMAIL=hello@orixo.studio

# File Upload Limits (MB)
MAX_INQUIRY_UPLOAD_MB=10
MAX_PROJECT_UPLOAD_MB=25
MAX_CMS_UPLOAD_MB=5
